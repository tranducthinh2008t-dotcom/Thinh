-- ===== CẤU HÌNH =====
local FPS_CAP = 20          -- 10-15: treo thuần | 30: vừa treo vừa xem
local HIDE_RADIUS = 10      -- vật thể xa hơn số này sẽ bị ẩn
local HIDE_KEYWORDS = {"house", "home", "building", "nha", "shop", "tower"}
local NOCLIP = true
local ANTI_FALL = true
local DISABLE_3D = false    -- true = màn hình đen, gần như không tốn GPU

