-- ===== XÓA HIỆU ỨNG =====
local function killEffect(v)
    if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Beam")
        or v:IsA("Smoke") or v:IsA("Fire") or v:IsA("Sparkles")
        or v:IsA("PointLight") or v:IsA("SpotLight") or v:IsA("SurfaceLight")
        or v:IsA("PostEffect") or v:IsA("Atmosphere")
        or v:IsA("Highlight") or v:IsA("Explosion") then
        v:Destroy()
    end
end
Lighting.GlobalShadows = false
Lighting.FogEnd = 9e9
for _, v in ipairs(Lighting:GetDescendants()) do pcall(killEffect, v) end
for _, v in ipairs(workspace:GetDescendants()) do pcall(killEffect, v) end
workspace.DescendantAdded:Connect(function(v) pcall(killEffect, v) end)

-- ===== ẨN NHÀ / CON / BẢNG TÊN (theo sự kiện) =====
if HIDE_STUFF and not DISABLE_3D then
    local function shouldHideModel(m)
        if m:FindFirstChildOfClass("Humanoid") and m ~= lp.Character then
            return true
        end
        local n = m.Name:lower()
        for _, k in ipairs(HIDE_KEYWORDS) do
            if n:find(k, 1, true) then return true end
        end
        return false
    end

    local function handle(v)
        local char = lp.Character
        if v:IsA("BillboardGui") then
            if not (char and v:IsDescendantOf(char)) then v.Enabled = false end
        elseif v:IsA("BasePart") and not v:IsA("Terrain") then
            if char and v:IsDescendantOf(char) then return end
            local m = v:FindFirstAncestorOfClass("Model")
            while m do
                if shouldHideModel(m) then
                    v.LocalTransparencyModifier = 1
                    return
                end
                m = m:FindFirstAncestorOfClass("Model")
            end
        end
    end

    for _, v in ipairs(workspace:GetDescendants()) do pcall(handle, v) end
    workspace.DescendantAdded:Connect(function(v)
        task.defer(pcall, handle, v)
    end)
end

-- ===== NOCLIP =====
RunService.Stepped:Connect(function()
    if not NOCLIP then return end
    local char = lp.Character
    if not char then return end
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then p.CanCollide = false end
    end
    if ANTI_FALL then
        local root = char:FindFirstChild("HumanoidRootPart")
        if root then
            local v = root.AssemblyLinearVelocity
            if v.Y < 0 then
                root.AssemblyLinearVelocity = Vector3.new(v.X, 0, v.Z)
            end
        end
    end
end)

-- ===== NHÃN HIỆN SỐ TẦNG (khi màn hình đen) =====
if SHOW_FLOOR_HUD then
    local gui = Instance.new("ScreenGui")
    gui.Name = "FloorHUD"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    local ok = pcall(function() gui.Parent = gethui and gethui() or game:GetService("CoreGui") end)
    if not ok or not gui.Parent then gui.Parent = lp:WaitForChild("PlayerGui") end

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0, 160, 0, 30)
    label.Position = UDim2.new(0.5, -80, 0, 50)
    label.BackgroundColor3 = Color3.new(0, 0, 0)
    label.BackgroundTransparency = 0.3
    label.TextColor3 = Color3.new(1, 1, 1)
    label.TextScaled = true
    label.Font = Enum.Font.GothamBold
    label.Text = "Tầng ?"
    label.Parent = gui

    local bound = {}
    local function bind(t)
        if bound[t] or not t:IsA("TextLabel") then return end
        if not t.Text:find("Tầng", 1, true) then return end
        bound[t] = true
        label.Text = t.Text
        t:GetPropertyChangedSignal("Text"):Connect(function()
            if t.Text:find("Tầng", 1, true) then label.Text = t.Text end
        end)
    end

    local function scan(char)
        for _, d in ipairs(char:GetDescendants()) do pcall(bind, d) end
        char.DescendantAdded:Connect(function(d) task.defer(pcall, bind, d) end)
    end
    if lp.Character then scan(lp.Character) end
    lp.CharacterAdded:Connect(scan)
end

print("Script đã bật | FPS " .. FPS_CAP .. " | 3D tắt: " .. tostring(DISABLE_3D))
