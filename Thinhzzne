-- ===== XÓA HIỆU ỨNG =====
local function killEffect(v)
    if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Beam")
        or v:IsA("Smoke") or v:IsA("Fire") or v:IsA("Sparkles")
        or v:IsA("PointLight") or v:IsA("SpotLight") or v:IsA("SurfaceLight")
        or v:IsA("PostEffect") or v:IsA("Atmosphere")
        or v:IsA("Highlight") or v:IsA("Explosion") then
        v:Destroy()
    end
end

pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)
Lighting.GlobalShadows = false
Lighting.FogEnd = 9e9
for _, v in ipairs(Lighting:GetDescendants()) do pcall(killEffect, v) end
for _, v in ipairs(workspace:GetDescendants()) do pcall(killEffect, v) end
workspace.DescendantAdded:Connect(function(v) pcall(killEffect, v) end)

-- ===== ẨN NHÀ / VẬT THỂ XUNG QUANH (bản nhẹ) =====
local parts = {}
local nameHide = {}

local function addPart(p)
    if p:IsA("BasePart") and not p:IsA("Terrain") then
        parts[#parts + 1] = p
        local m = p:FindFirstAncestorOfClass("Model")
        if m then
            local n = m.Name:lower()
            for _, k in ipairs(HIDE_KEYWORDS) do
                if n:find(k) then nameHide[p] = true break end
            end
        end
    end
end

for _, v in ipairs(workspace:GetDescendants()) do addPart(v) end
workspace.DescendantAdded:Connect(addPart)

local function isCharacter(p)
    local m = p:FindFirstAncestorOfClass("Model")
    return m and m:FindFirstChildOfClass("Humanoid") ~= nil
end

task.spawn(function()
    while task.wait(3) do
        local char = lp.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if root then
            local pos = root.Position
            for i = #parts, 1, -1 do
                local p = parts[i]
                if not p.Parent then
                    table.remove(parts, i)
                elseif not p:IsDescendantOf(char) then
                    local hide = nameHide[p] or (p.Position - pos).Magnitude > HIDE_RADIUS
                    if hide and isCharacter(p) then hide = false end
                    p.LocalTransparencyModifier = hide and 1 or 0
                end
                if i % 400 == 0 then task.wait() end
            end
        end
    end
end)

-- ===== ẨN CÁC CON / NHÂN VẬT KHÁC =====
local function hideModel(m)
    if m == lp.Character then return end
    for _, d in ipairs(m:GetDescendants()) do
        if d:IsA("BasePart") then
            d.LocalTransparencyModifier = 1
        elseif d:IsA("BillboardGui") then
            d.Enabled = false
        elseif d:IsA("Decal") then
            d.Transparency = 1
        end
    end
end

task.spawn(function()
    while task.wait(2) do
        for _, h in ipairs(workspace:GetDescendants()) do
            if h:IsA("Humanoid") and h.Parent and h.Parent ~= lp.Character then
                pcall(hideModel, h.Parent)
            elseif h:IsA("BillboardGui") and not h:IsDescendantOf(lp.Character or workspace) then
                pcall(function() h.Enabled = false end)
            end
        end
    end
end)

-- ===== NOCLIP =====
RunService.Stepped:Connect(function()
    if not NOCLIP then return end
    local char = lp.Character
    if not char then return end
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then p.CanCollide = false end
    end
    if ANTI_FALL then
        local root = char:FindFirstChild("HumanoidRootPart")
        if root then
            local v = root.AssemblyLinearVelocity
            if v.Y < 0 then
                root.AssemblyLinearVelocity = Vector3.new(v.X, 0, v.Z)
            end
        end
    end
end)

